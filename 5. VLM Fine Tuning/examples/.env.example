# 이 파일을 .env로 복사한 뒤 값을 채우세요: cp .env.example .env
# .env는 .gitignore에 의해 커밋되지 않습니다.

# HuggingFace 토큰 (gated 데이터셋 다운로드 + 데이터셋 업로드에 필요, write 권한)
# 발급: https://huggingface.co/settings/tokens
HF_TOKEN=

# 노트북 1이 업로드하고, 이후 노트북들이 다운로드할 때 사용하는 데이터셋 repo ID
# 예: your-username/chartqa-kor-vlm-lab
HF_DATASET_REPO_ID=
